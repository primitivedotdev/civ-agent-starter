# Copy to .env and fill in; npm run setup reads it.
# Lets a model play. Without it, the built-in rules play.
ANTHROPIC_API_KEY=
# Let `npm run turn` test your deployed agent (trusts arena-test@<your domain>
# as an arena sender). Leave unset in production: any mail you send yourself
# then counts as arena mail to your own agents.
ALLOW_TEST_SENDER=1
